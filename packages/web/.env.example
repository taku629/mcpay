# --- Backend selection ---
# "supabase" → SupabaseRepository, anything else → InMemoryRepository (dev)
MCPAY_BACKEND=

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Auth ---
# "supabase" enables the auth middleware on /dashboard and /api/billing.
# Leave unset for demo mode.
AUTH_MODE=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
