# --- Backend selection ---
# "supabase" → SupabaseRepository, anything else → InMemoryRepository (dev)
MCPAY_BACKEND=

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
# Public anon key. Used by server routes to call /auth/v1/otp on behalf of
# users requesting magic-link emails.
SUPABASE_ANON_KEY=eyJhbGc...
# Optional: only set for legacy HS256-signed Supabase projects. Modern projects
# use asymmetric keys (RS256/ES256) and JWTs are verified via JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json — leave blank in that case.
SUPABASE_JWT_SECRET=

# --- Auth ---
# "supabase" enables real email magic-link login + middleware gates on
# /dashboard and /api/billing. Leave unset for demo mode (always-on demo user).
AUTH_MODE=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron ---
# Shared secret for /api/cron/* endpoints. On Vercel, set this in the project
# env and the cron jobs in vercel.json automatically include
# "Authorization: Bearer ${CRON_SECRET}". Locally, hit the routes with
# `?secret=<value>` or the same header.
CRON_SECRET=
